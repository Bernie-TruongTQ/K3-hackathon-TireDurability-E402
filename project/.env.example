# Application Settings
APP_NAME="Document Understanding API"
APP_VERSION="1.0.0"
DEBUG=False

# Paths (optional - will use defaults if not set)
# OUTPUT_DIR="ocr_output"
# DB_PATH="db_chromadb"
# TEMP_DIR="temp"

# OCR Settings
# OCR_DPI=200
# SKIP_FIRST_N_PAGES=3

# Embedding Settings
# EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
# COLLECTION_NAME="documents"

# Retrieval Settings
# RETRIEVAL_TOP_K=50
# RERANK_TOP_K=5
# RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# LLM Settings
# LLM_PROVIDER="qwen"  # Options: "qwen" or "gemini"

# Local LLM (Qwen) Settings
# LOCAL_LLM_MODEL="Qwen/Qwen3-0.6B"
# LOCAL_LLM_MAX_TOKENS=1024
# LOCAL_LLM_TEMPERATURE=0.3

# Gemini Settings (required if using Gemini)
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY_HERE"
# GEMINI_MODEL="gemini-2.5-pro"
# GEMINI_MAX_TOKENS=1024
# GEMINI_TEMPERATURE=0.3
