# Application Settings
VISUALRAG_APP_NAME="VLearn VisualRAG API"
VISUALRAG_APP_VERSION="1.0.0"
VISUALRAG_DEBUG=False

# Paths (optional - will use defaults if not set)
# OUTPUT_DIR="ocr_output"
# DB_PATH="db_chromadb"
# TEMP_DIR="temp"

# OCR Settings
# OCR_DPI=200
# SKIP_FIRST_N_PAGES=3

# Embedding Settings
# EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
# COLLECTION_NAME="documents"

# Retrieval Settings
# RETRIEVAL_TOP_K=50
# RERANK_TOP_K=5
# RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# LLM Settings
# Options: "demo", "openai", "qwen" or "gemini"
VISUALRAG_LLM_PROVIDER="openai"

# Local LLM (Qwen) Settings
# LOCAL_LLM_MODEL="Qwen/Qwen3-0.6B"
# LOCAL_LLM_MAX_TOKENS=1024
# LOCAL_LLM_TEMPERATURE=0.3

VISUALRAG_VECTOR_STORE_PROVIDER="local"
VISUALRAG_RERANKER_PROVIDER="lexical"

# OpenAI Responses API (required for the CP3 real-model run)
# Copy this file to project/.env, then replace the placeholder locally.
VISUALRAG_OPENAI_API_KEY="replace-with-your-openai-api-key"
VISUALRAG_OPENAI_MODEL="gpt-4o-mini"
VISUALRAG_OPENAI_MAX_OUTPUT_TOKENS=1024
VISUALRAG_OPENAI_TEMPERATURE=0.2

# Gemini Settings (only required if using Gemini)
VISUALRAG_GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY_HERE"
# GEMINI_MODEL="gemini-2.5-pro"
# GEMINI_MAX_TOKENS=1024
# GEMINI_TEMPERATURE=0.3
